{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vpn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9de2f78d-7267-4d53-b4d0-8123094b1bbe","database_name": "vpn" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e1c5ed2dc55f4d1795ba7609fa4319c0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
